+// Opt-in vector loads: four adjacent values share one scale and a quarter-warp reduction.
+// Every 16/32-value quantization group and every scalar rounding operation is unchanged.
+template <int BS>
+static __global__ void dsv41_fake_quant_vec4_f32(const float4 * __restrict__ x, float4 * __restrict__ y,
+                                               const int64_t n4, const int mode, const float maxv, const float floor_) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const float4 v4 = i < n4 ? x[i] : make_float4(0, 0, 0, 0);
+    float a = i < n4 ? fmaxf(fmaxf(fabsf(v4.x), fabsf(v4.y)), fmaxf(fabsf(v4.z), fabsf(v4.w))) : -FLT_MAX;
+#pragma unroll
+    for (int o = BS / 8; o > 0; o >>= 1) {
+        a = fmaxf(a, __shfl_xor_sync(0xffffffff, a, o, BS / 4));
+    }
+    if (i >= n4) return;
+    const float t = dsv41_fq_clamp(a, floor_, INFINITY) / maxv;
+    const float s = mode == 1 ? dsv41_fq_round_fmt(t, 3, 0x1p-6f) : dsv41_fq_pow2_ceil(t);
+    const float input[4] = {v4.x, v4.y, v4.z, v4.w};
+    float output[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const float v = dsv41_fq_clamp(input[j] / s, -maxv, maxv);
+        const float q = mode == 0 ? dsv41_fq_round_fmt(v, 3, 0x1p-6f) : dsv41_fq_round_fmt(v, 1, 1.0f);
+        output[j] = __fmul_rn(q, s);
+    }
+    y[i] = make_float4(output[0], output[1], output[2], output[3]);
+}
